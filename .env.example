# Copy to .env.local for local development, and add the same values in your
# hosting dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# 1 = serve images/videos/3D models from public/media (after `npm run download-media`).
# Leave unset/0 to keep loading them from the old WordPress server.
NEXT_PUBLIC_LOCAL_MEDIA=0

# Contact form email (any SMTP provider: Gmail/Google Workspace app password, Zoho, Brevo, Hostinger mail…)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@legacyfoods.pk
SMTP_PASS=your-app-password
# Where form messages are delivered (defaults to info@legacyfoods.pk)
CONTACT_TO=info@legacyfoods.pk
